def load_existing_receipts():
    try:
        with open("assesment.txt", "r") as file:
            for line in file:
                costumer_name, item_name, number_of_items, receipt_code = line.strip().split(",")
                receipt_details = {
                    "costumer_name": costumer_name,
                    "item_name": item_name,
                    "number_of_items": number_of_items,
                    "receipt_code": receipt_code
                }
                assessment.append(receipt_details)
    except FileNotFoundError:
        # File does not exist, meaning no receipts have been saved yet
        pass

