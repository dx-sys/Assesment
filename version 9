def return_item():
    def validate_return():
        customer_name_input = costumer_name.get()
        item_name_input = item_name.get()
        number_of_items_input = number_of_items.get()
        receipt_code_input = receipt_code.get()

        return_confirm= messagebox.askyesno("","Are you sure you want to return these items?")
        if not return_confirm:
            return

        # Validation checks
        if not customer_name_input or not item_name_input or not number_of_items_input or not receipt_code_input:
            messagebox.showwarning("Warning", "Please fill in all fields.")
            return
        elif not check_length(customer_name_input):
            messagebox.showerror("Input Error", "Full name must be at most 20 characters long.")
            return
        elif not check_text(customer_name_input):
            messagebox.showerror("Input Error", "Full name must contain only alphabets.")
            return
        elif not number_of_items_input.isdigit() or int(number_of_items_input) < 1:
            messagebox.showerror("Input Error", "Number of items must be a positive integer and whole number.")
            return
        elif not item_name_input in ["Chair", "Balloon", "Candle", "Tables", "Confettis", "Garland", "Party Hats"]:
            messagebox.showerror("Input Error", "Item must be one of the listed products.")
            return
        elif len(receipt_code_input) > 5:
            messagebox.showerror("Input Error", "Receipt code must be at most 5 characters long.")
            return
        elif int(number_of_items_input) > 500:
            messagebox.showerror("Input Error", "Number of items must not exceed 500.")
            return
        else:
# Check if receipt code exists and matches other details, remove the receipt from the assessment list and update the text file to remove the returned receipt
            for receipt in assessment:
                if (receipt["receipt_code"] == receipt_code_input and 
                    receipt["costumer_name"] == customer_name_input and 
                    receipt["item_name"] == item_name_input):
                    
                    hired_quantity = int(receipt["number_of_items"])
                    return_quantity = int(number_of_items_input)

                    if return_quantity > hired_quantity:
                        messagebox.showerror("Error", "Cannot return more items than hired.")
                        return
                    elif return_quantity == hired_quantity:
                        assessment.remove(receipt)
                    else:
                        receipt["number_of_items"] = str(hired_quantity - return_quantity)

                    with open("assesment.txt", "w") as file:
                        for remaining_receipt in assessment:
                            file.write(f"{remaining_receipt['costumer_name']},{remaining_receipt['item_name']},{remaining_receipt['number_of_items']},{remaining_receipt['receipt_code']}\n")

                    messagebox.showinfo("Success", "Item returned successfully.")
                    return_window.destroy()
                    return
            
            messagebox.showerror("Error", "Invalid return details(Double check if information is right).")
#return window.       
