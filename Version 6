    tkinter.Label(view_recipts_window, text="Receipt Code", font=("Arial", 10, "bold")).grid(row=1, column=3, padx=5)

    # Populate the table with receipts
    for idx, receipt in enumerate(assessment):
        tkinter.Label(view_recipts_window, text=receipt["costumer_name"]).grid(row=idx + 2, column=0, padx=5)
        tkinter.Label(view_recipts_window, text=receipt["item_name"]).grid(row=idx + 2, column=1, padx=5)
        tkinter.Label(view_recipts_window, text=receipt["number_of_items"]).grid(row=idx + 2, column=2, padx=5)
        tkinter.Label(view_recipts_window, text=receipt["receipt_code"]).grid(row=idx + 2, column=3, padx=5)

    # Add a close button
    close_button = ttk.Button(view_recipts_window, text="Close", command=view_recipts_window.destroy)
    close_button.grid(row=len(assessment) + 2, column=0, columnspan=4, pady=10)

